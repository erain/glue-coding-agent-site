---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";

const title = "glue — AX-first, remote-first coding agent for your terminal & browser";
const description =
  "glue is an open-source coding agent in one static Go binary. Code interactively in a terminal TUI, hand off uncommitted work to isolated AX gVisor sandboxes in 3 seconds, answer from phone lock-screen buttons at 0 CPU, steer from a Zero-Trust Cloudflare Access browser workspace, and teleport tested patches + context home — across Gemini, Codex, DeepSeek, OpenRouter, and NVIDIA.";

const remoteFeatures = [
  {
    title: "Dirty-tree safe (--snapshot)",
    body: "Jobs start from your branch. Uncommitted edits? glue refuses to silently drop local WIP — pass <code>--snapshot</code> to package your working tree onto a temporary ref.",
  },
  {
    title: "Direct ephemeral mTLS, RAM-only secrets",
    body: "<code>PodCertificateRequest</code> + <code>atenet-router</code> mTLS straight to AX with zero mandatory gateway. API keys and GitHub tokens go to <code>/v1/credentials</code> in memory — 0 bytes on disk.",
  },
  {
    title: "Parallel attempts & pick",
    body: "<code>--attempts 3</code> (and repeated <code>--model</code>) runs sandboxes in parallel; <code>glue job compare</code> lines up diffstats, tokens, and tests so <code>pick</code> keeps the winner.",
  },
  {
    title: "Issues in, review rounds out",
    body: "<code>--issue 123</code> reads the GitHub issue + comments and opens a closing Draft PR. <code>glue job continue --from-pr</code> feeds review threads and failed CI logs back into the sandbox.",
  },
  {
    title: "Steer mid-flight",
    body: "<code>glue job say</code> queues guidance before the next model turn; <code>--interrupt</code> cancels the active model stream or shell command and redirects immediately.",
  },
  {
    title: "Repo-wide .glue/remote.yaml",
    body: "Check in <code>setup</code>, <code>verify</code>, <code>deliver</code>, <code>egress_hosts</code>, <code>resources</code>, and <code>budgets</code> once so every teammate's <code>glue --remote</code> obeys the repo gate.",
  },
];

const anywhereFeatures = [
  {
    title: "Zero-CPU suspend + lock-screen buttons",
    body: "Pair once via <code>glue job init</code> QR. On <code>ask_user</code> or permission prompts, AX suspends the sandbox to disk (0 vCPU) and pushes native HTTP <code>POST</code> buttons to <code>ntfy</code> on your phone.",
  },
  {
    title: "Cloudflare Access browser workspace",
    body: "<code>glue remote setup</code> deploys a 1-pod gateway + <code>cloudflared</code> consuming <strong>0 idle AX workers</strong>. Verifies <code>Cf-Access-Jwt-Assertion</code> JWTs — zero OAuth app, zero second login.",
  },
  {
    title: "Explore in chat → Run Autonomously",
    body: "Start an interactive workspace in <code>#/new</code> (auto-suspending between turns), then escalate the exact same sandbox in 1 click into <code>Planner → Maker → Checker</code> + unified diff + Draft PR.",
  },
  {
    title: "Teleport code + context home",
    body: "<code>glue job teleport</code> (or pressing <code>t</code> in <code>/jobs</code>) safely applies the patch onto matching <code>--snapshot</code> branches and hydrates a provider-neutral session briefing in your local TUI.",
  },
];

const cliRows = [
  { cmd: "glue / glue code", desc: "Interactive terminal coding TUI (--continue, --select, --model, --prompt)." },
  { cmd: "glue job init", desc: "Doctor preflight + one-time QR phone pairing (~/.config/glue/config.yaml, 0600)." },
  { cmd: 'glue --remote "<goal>"', desc: "Dispatch to an AX gVisor sandbox (-i interactive, --snapshot, --verify, --attempts, --issue)." },
  { cmd: "glue remote setup", desc: "One-time opt-in cluster gateway with Cloudflare Access & Tunnel (0 idle AX workers)." },
  { cmd: "glue job ui [--tunnel]", desc: "Instant local browser UI with #token magic link (and optional cloudflared phone QR)." },
  { cmd: "glue job attach | list | show", desc: "Live resumable transcript (Ctrl-C detaches) or cached status without waking suspended tasks." },
  { cmd: "glue job say | answer", desc: "Steer a running maker (--interrupt) or unblock a question/permission from any terminal." },
  { cmd: "glue job diff | pull | pr", desc: "Inspect unified patch, pull branch/working-tree (--apply), or open an upstream Draft PR." },
  { cmd: "glue job teleport [<id>]", desc: "Pull git changes + redacted [user, assistant] handoff briefing directly into local TUI." },
  { cmd: 'glue goal "<goal>"', desc: "Local autonomous Planner → Maker → Checker loop (--coding, --worktree, --resume)." },
  { cmd: "glue run | models | serve", desc: "Headless/piped prompts (--mode json), offline model catalog, and local HTTP+SSE daemon." },
];

const providers = [
  {
    title: "Gemini (primary)",
    body: "Google's genai SDK with Gemini 3 & 4 thinking levels, thought-signature round-tripping, and streamed reasoning. Coding defaults to <code>gemini-3-flash-preview</code> (<code>low</code> thinking, ~1s/turn).",
  },
  {
    title: "Codex — your ChatGPT subscription",
    body: "No per-token bill. Run <code>codex login</code> once; glue reuses <code>~/.codex/auth.json</code> for personal coding sessions.",
  },
  {
    title: "DeepSeek",
    body: "Native <code>DEEPSEEK_API_KEY</code> adapter defaulting to <code>deepseek-flash</code> (<code>off</code>/<code>low</code>/<code>high</code>/<code>max</code> thinking) with streamed reasoning replay across tool calls.",
  },
  {
    title: "OpenRouter — open-weight models",
    body: "Kimi K2, Qwen, GLM, Llama and friends by ID — or <code>openrouter/free</code>, which auto-selects a free model for zero-key runs.",
  },
  {
    title: "NVIDIA build + failover",
    body: "OpenAI-compatible open-weight endpoints via <code>NVIDIA_API_KEY</code>. <code>glue.WithFailover</code> automatically skips providers without configured keys.",
  },
  {
    title: "Offline catalog & live picker",
    body: "<code>glue models</code> lists curated defaults and verified thinking levels without credentials; <code>glue run --select</code> opens an interactive arrow-key picker.",
  },
];

const harnessFeatures = [
  {
    title: "Self-repairing edits",
    body: "Models misquote whitespace, indentation, and smart quotes constantly. <code>edit_file</code> repairs the drift with a deterministic match ladder, reports what it fixed, and echoes the updated lines back.",
  },
  {
    title: "Logs that keep the part that matters",
    body: "Long build output keeps the first error <em>and</em> the final status (head + tail), with the complete stream spooled to a named temp file the model can read back.",
  },
  {
    title: "Transcript repair",
    body: "Interrupted turns leave dangling tool calls that providers reject with opaque 400s. Every run repairs the history first — cancel, crash, resume, and model switches just work.",
  },
  {
    title: "Retries + overflow recovery",
    body: "Rate limits and dropped streams retry with backoff (honoring server hints); a blown context window triggers compact-once-and-retry instead of a dead session.",
  },
  {
    title: "Loop guardrails",
    body: "Repeating the same tool call, or burning turn after turn on failing calls, draws a corrective nudge first — and a clean typed stop if the model ignores it.",
  },
  {
    title: "Stall recovery",
    body: "Gemini's classic “I will now edit the file.”-then-silence gets a bounded “Please continue.” — the narration becomes the action.",
  },
];

const tuiFeatures = [
  {
    title: "Tool cards with inline permissions",
    body: "Every side-effecting tool call renders as a card with a spinner — and the [a]llow / [s]ession / [t]his-file / [n]o prompt right inside it. Reads never nag.",
  },
  {
    title: "/jobs Mission Control & /teleport",
    body: "Live status bar (<code>⧗ N remote jobs · M waiting</code>) without waking suspended sandboxes. Open <code>/jobs</code> to toggle diffs (<code>d</code>), steer (<code>s</code>/<code>i</code>), open Draft PRs (<code>o</code>), or teleport home (<code>t</code>).",
  },
  {
    title: "@-file & /-command pickers",
    body: "Type <code>@</code> to fuzzy-pick workspace files inline (secrets blocklisted); type <code>/</code> for command autocomplete; <code>Ctrl+Y</code> / <code>/copy</code> copies raw Markdown over SSH via OSC 52.",
  },
  {
    title: "edit_file diff preview & Markdown",
    body: "Inspect surgical replacements before approving. Streaming text settles into rendered Markdown with mouse-wheel, PgUp/PgDn, and sticky-bottom scroll.",
  },
  {
    title: "Session tree (/fork, /clone, /tree)",
    body: "<code>/fork</code> branches from any message, <code>/clone</code> duplicates, and <code>/tree</code> visualizes the <code>├─ / └─</code> lineage to switch branches cleanly.",
  },
  {
    title: "Token-aware compaction",
    body: "<code>/compact</code> summarizes older turns into a structured state snapshot with a cumulative read/modified file ledger that survives repeated compactions.",
  },
];
---

<Base title={title} description={description}>
  <section class="border-b border-line">
    <div class="max-w-3xl mx-auto px-6 pt-16 pb-16 sm:pt-20 sm:pb-20">
      <pre class="ascii-logo mb-8" aria-hidden="true">
       _
  __ _| |_   _  ___
 / _` | | | | |/ _ \
| (_| | | |_| |  __/
 \__, |_|\__,_|\___|
 |___/</pre>
      <div class="text-xs text-ink-muted tracking-wider mb-6">
        <span class="text-accent">[</span> ax-first <span class="text-accent">·</span> remote-first <span class="text-accent">·</span> one static go binary <span class="text-accent">·</span> MIT <span class="text-accent">]</span>
      </div>
      <h1 class="text-3xl sm:text-[2.6rem] font-bold tracking-tight text-ink leading-[1.15] mb-6">
        In your terminal. On AX.
        <br class="hidden sm:block" />
        <span class="glow">On any model.</span>
      </h1>
      <p class="text-base sm:text-lg text-ink-soft leading-relaxed max-w-2xl mb-10">
        <strong class="text-ink font-semibold">glue</strong> is an open-source coding agent
        that runs locally in a fast terminal TUI and remotely inside isolated
        <a href="https://github.com/google/ax" class="text-accent underline" rel="noopener">AX</a>
        gVisor sandboxes. Dispatch uncommitted work in 3 seconds, tap answers from
        phone lock-screen buttons at 0 CPU, control workspaces from a Zero-Trust
        Cloudflare Access browser URL, and teleport tested code + context back into
        your checkout.
      </p>
      <div class="flex flex-wrap items-center gap-3 mb-10">
        <a href="https://github.com/erain/glue#the-glue-cli" class="btn btn-solid" rel="noopener">
          [ get started ]
        </a>
        <a href="https://github.com/erain/glue/blob/main/docs/remote-quickstart.md" class="btn btn-ghost" rel="noopener">
          [ remote in 5 min ]
        </a>
        <a href="https://github.com/erain/glue/blob/main/docs/cli.md" class="btn btn-ghost" rel="noopener">
          [ cli &amp; tui docs ]
        </a>
      </div>
      <div class="term">
        <div class="term-bar">
          <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
          <span class="term-title">erain@dev: ~/src/payments (feat/jitter*)</span>
        </div>
        <pre class="term-body"><code><span class="tok-g">$</span> go install github.com/erain/glue/cmd/glue@latest
<span class="tok-g">$</span> glue                               <span class="tok-d"># interactive local coding TUI</span>
<span class="tok-g">$</span> glue <span class="tok-a">--remote</span> <span class="tok-c">"Add bounded jitter &amp; race tests"</span> \
    <span class="tok-a">--snapshot --verify</span> <span class="tok-c">"go test -race ./limiter/..."</span>
  <span class="tok-c">[2.8s]</span> started <span class="tok-b">job-7c4e91a0</span> <span class="tok-d">· gVisor sandbox · safe to close lid</span>
         browser <span class="tok-g">https://glue.acme.dev/#/jobs/job-7c4e91a0</span>

<span class="tok-g">$</span> glue job teleport latest           <span class="tok-d"># pulls patch + session briefing into TUI</span>
  <span class="tok-g">✓</span> applied to feat/jitter <span class="tok-d">·</span> hydrated .glue/sessions/teleport-7c4e91a0.json</code></pre>
      </div>
      <div class="text-xs text-ink-muted tracking-wide mt-6">
        ax gvisor sandboxes <span class="text-accent">·</span> cloudflare access webui <span class="text-accent">·</span> ntfy lock-screen push <span class="text-accent">·</span> teleport <span class="text-accent">·</span> gemini <span class="text-accent">·</span> codex <span class="text-accent">·</span> deepseek <span class="text-accent">·</span> openrouter <span class="text-accent">·</span> nvidia
      </div>
    </div>
  </section>

  <Section num="01" id="what" eyebrow="What it is" title="One harness across local terminals, AX sandboxes, and every model.">
    <p>
      Most coding agents lock you to one model vendor and die the moment you close
      your laptop lid. glue separates <strong>where work executes</strong> (locally in
      your checkout or remotely on <a href="https://github.com/google/ax" rel="noopener">AX</a>)
      from <strong>which model thinks</strong> — running the exact same tool bundle,
      goal loop, and transcript hardening across <strong>Gemini</strong>,
      <strong>Codex</strong> (your ChatGPT subscription), <strong>DeepSeek</strong>,
      <strong>OpenRouter</strong>, and <strong>NVIDIA</strong>.
    </p>
    <p>
      It ships as one static Go binary — no Node, Python, or Docker required on your
      laptop — and is built directly on the public
      <a href="https://glue-framework-site.vercel.app" rel="noopener">glue Go agent framework</a>
      (<a href="https://github.com/erain/glue/blob/main/docs/adr/0012-sdk-coding-agent-peggy-boundary.md" rel="noopener">ADR-0012</a>).
    </p>
  </Section>

  <Section num="02" id="remote" tone="soft" eyebrow="Remote Dispatch" title="Fire from a dirty branch in 3 seconds. Zero cluster setup.">
    <p>
      <code>glue --remote</code> talks straight to AX over ephemeral
      <code>PodCertificateRequest</code> mTLS
      (<a href="https://github.com/erain/glue/blob/main/docs/adr/0020-ax-first-direct-execution.md" rel="noopener">ADR-0020</a>)
      using the published <code>ghcr.io/erain/glue-task</code> image (Go, Node.js,
      Python, C/C++, ripgrep, jq). Run <code>glue job init</code> once to verify
      connectivity and pair your phone via QR code.
    </p>
    <div class="term">
      <div class="term-bar">
        <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
        <span class="term-title">erain@dev: ~/src/yourrepo</span>
      </div>
      <pre class="term-body"><code><span class="tok-g">$</span> glue job init                         <span class="tok-d"># doctor checks + QR phone pairing (0600 config.yaml)</span>
<span class="tok-g">$</span> glue <span class="tok-a">--remote</span> <span class="tok-c">"Add Sub(a, b int) next to Add, with table-driven tests"</span> \
    <span class="tok-a">--snapshot --attempts 2 --verify</span> <span class="tok-c">"go test ./..."</span>
  <span class="tok-d">submitted 2 jobs in 6.0s · group grp-feb93e9dc9ca</span>
<span class="tok-g">$</span> glue job compare grp-feb93e9dc9ca
  job-f8a57d276fb8  achieved  <span class="tok-g">pass</span>  2 files +38 -0  2m50s  42090 tok
  job-cf7e5e72a8c4  achieved  <span class="tok-g">pass</span>  2 files +28 -0  2m58s  68290 tok
<span class="tok-g">$</span> glue job pick job-f8a57d276fb8        <span class="tok-d"># opens Draft PR &amp; cleans up sibling attempts</span></code></pre>
    </div>
    <div class="cap-grid mt-8">
      {remoteFeatures.map((c) => (
        <div class="cap-card">
          <h3>{c.title}</h3>
          <p set:html={c.body}></p>
        </div>
      ))}
    </div>
  </Section>

  <Section num="03" id="anywhere" eyebrow="Anywhere UX" title="Close the laptop: lock-screen buttons, Zero-Trust browser & teleport.">
    <p>
      Add an opt-in, bookmarkable browser workspace to your cluster in one command
      (<a href="https://github.com/erain/glue/blob/main/docs/adr/0021-opt-in-cluster-gateway-cloudflare-access.md" rel="noopener">ADR-0021</a>) —
      or run <code>glue job ui --open --tunnel</code> for an instant local magic-link
      UI with a phone QR code. Idle sandboxes suspend to disk at <strong>0 CPU</strong>,
      and read-only views never wake them.
    </p>
    <div class="cap-grid mt-6 mb-6">
      <div class="term">
        <div class="term-bar">
          <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
          <span class="term-title">https://glue.acme.dev/#/jobs/job-7c4e91a0</span>
        </div>
        <pre class="term-body"><code><span class="tok-g">✓ CF Access:</span> dev@acme.dev <span class="tok-d">(0 idle AX workers)</span>

<span class="tok-b">Interactive Chat</span> <span class="tok-d">→</span> <span class="tok-g">edit_file</span> limiter/retry.go <span class="tok-g">✓</span>
<span class="tok-a">[ Run Autonomously ]</span> verify: <span class="tok-c">go test -race ./...</span>

<span class="tok-g">ACHIEVED</span> <span class="tok-d">·</span> EXIT 0 <span class="tok-d">·</span> +42 -3
<span class="tok-g">▶</span> <span class="tok-b">[ Open Draft PR #142 ]</span></code></pre>
      </div>
      <div class="term">
        <div class="term-bar">
          <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
          <span class="term-title">phone lock screen · ntfy · laptop closed</span>
        </div>
        <pre class="term-body"><code><span class="tok-a">SUSPENDED</span> <span class="tok-d">· 0.00 vCPU · ask_user</span>
At MaxAttempts (5), cap delay or error?

<span class="tok-d">[ Cap delay at 30s ]</span>
<span class="tok-g">[ Return ErrRetryExhausted ]</span> <span class="tok-d">← HTTP POST</span>

<span class="tok-g">✓ Woke sandbox in 1.4s</span> <span class="tok-d">· token redacted</span></code></pre>
      </div>
    </div>
    <pre><code><span class="tok-d"># one-time cluster browser workspace (Cloudflare Access JWT + Tunnel, 0 AX workers used)</span>
<span class="tok-g">$</span> glue remote setup <span class="tok-a">--public-url</span> https://glue.acme.dev \
    <span class="tok-a">--cf-team</span> acme.cloudflareaccess.com <span class="tok-a">--cf-aud</span> &lt;aud&gt; <span class="tok-a">--allow-email</span> you@acme.dev \
    <span class="tok-a">--tunnel-token</span> <span class="tok-c">"$CLOUDFLARE_TUNNEL_TOKEN"</span>

<span class="tok-d"># back at your desk: pull git changes + provider-neutral session briefing into local TUI</span>
<span class="tok-g">$</span> glue job teleport job-7c4e91a0</code></pre>
    <div class="cap-grid mt-8">
      {anywhereFeatures.map((c) => (
        <div class="cap-card">
          <h3>{c.title}</h3>
          <p set:html={c.body}></p>
        </div>
      ))}
    </div>
    <p class="mt-8">
      Verified on every release against a live Kind + gVisor + headless Chrome stack by
      <a href="https://github.com/erain/glue/blob/main/scripts/demo/aha.sh" rel="noopener"><code>scripts/demo/aha.sh</code></a>
      and
      <a href="https://github.com/erain/glue/blob/main/scripts/demo/anywhere.sh" rel="noopener"><code>scripts/demo/anywhere.sh</code></a>.
    </p>
  </Section>

  <Section num="04" id="tui" tone="soft" eyebrow="Interactive" title="A TUI that stays out of the way — with remote Mission Control built in.">
    <div class="term">
      <div class="term-bar">
        <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
        <span class="term-title">glue · session 4f2a · gemini-3-flash · ⧗ 2 remote jobs · 1 waiting</span>
      </div>
      <pre class="term-body"><code><span class="tok-g">▶</span> <span class="tok-b">edit_file</span>  internal/server/router.go
    <span class="tok-r">- mux.Handle("/healthz", health)</span>
    <span class="tok-g">+ mux.Handle("/healthz", logged(health))</span>
    <span class="tok-a">[a]llow once   [s]ession   [t]his file   [n]o</span>

<span class="tok-c">⠸</span> <span class="tok-b">shell_exec</span>  go test ./internal/server/

  All 14 tests pass. Type <span class="tok-c">/remote</span> to hand off the soak suite,
  or <span class="tok-c">/jobs</span> to inspect &amp; teleport finished AX runs.

<span class="tok-a">›</span> /remote --snapshot Add 16-goroutine race tests across router/<span class="cursor" aria-hidden="true"></span></code></pre>
    </div>
    <div class="cap-grid mt-8">
      {tuiFeatures.map((c) => (
        <div class="cap-card">
          <h3>{c.title}</h3>
          <p set:html={c.body}></p>
        </div>
      ))}
    </div>
    <p class="mt-8">
      Run bare <code>glue</code> (or <code>glue code --continue</code>) in any
      checkout to launch the TUI. Designed in
      <a href="https://github.com/erain/glue/blob/main/docs/adr/0014-coding-agent-tui.md" rel="noopener">ADR-0014</a>
      and <a href="https://github.com/erain/glue/blob/main/docs/adr/0015-session-tree.md" rel="noopener">ADR-0015</a>.
    </p>
  </Section>

  <Section num="05" id="goal" eyebrow="Autonomous" title="The goal loop: plan, make, verify — repeat.">
    <p>
      <code>/goal</code> in the TUI, <code>glue goal</code> locally, and
      <code>glue --remote</code> on AX all share the same autonomous engine: a
      planner decomposes the objective into a verifiable checklist, a fresh
      <strong>maker</strong> session executes each iteration, and an independent
      read-only <strong>checker</strong> audits the evidence — the writer never
      grades its own homework.
    </p>
    <pre><code><span class="tok-d"># isolated local git worktree goal (your checkout stays untouched on branch goal/&lt;id&gt;)</span>
<span class="tok-g">$</span> glue goal <span class="tok-a">--coding --yolo --worktree</span> \
    <span class="tok-c">"Make golangci-lint pass on ./... without disabling checks"</span>

<span class="tok-d"># exit code reflects the outcome for CI / cron:</span>
<span class="tok-d">#</span> <span class="tok-g">0</span> achieved <span class="tok-d">·</span> <span class="tok-a">2</span> blocked <span class="tok-d">·</span> <span class="tok-a">3</span> max-iterations <span class="tok-d">·</span> <span class="tok-a">4</span> budget <span class="tok-d">·</span> <span class="tok-r">1</span> error

<span class="tok-g">$</span> glue goal <span class="tok-a">--list</span> &amp;&amp; glue goal <span class="tok-a">--resume</span></code></pre>
    <p>
      Goals checkpoint to the session store after every iteration so they survive
      restarts and AX suspend/resume cycles without re-planning. Designed in
      <a href="https://github.com/erain/glue/blob/main/docs/adr/0016-goal-loop.md" rel="noopener">ADR-0016</a>.
    </p>
  </Section>

  <Section num="06" id="cli" tone="soft" eyebrow="CLI Reference" title="Every command in one static binary.">
    <div class="term">
      <div class="term-bar">
        <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
        <span class="term-title">glue --help</span>
      </div>
      <div class="overflow-x-auto">
        <table class="cmd-table">
          <thead>
            <tr>
              <th>Command</th>
              <th>What it does</th>
            </tr>
          </thead>
          <tbody>
            {cliRows.map((r) => (
              <tr>
                <td><code>{r.cmd}</code></td>
                <td>{r.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-6">
      Full flags, TUI hotkeys, and <code>.glue/remote.yaml</code> schema live in
      <a href="https://github.com/erain/glue/blob/main/docs/cli.md" rel="noopener"><code>docs/cli.md</code></a>
      and
      <a href="https://github.com/erain/glue/blob/main/docs/jobs.md" rel="noopener"><code>docs/jobs.md</code></a>.
    </p>
  </Section>

  <Section num="07" id="providers" eyebrow="Models" title="Bring a key, a subscription, or neither.">
    <div class="cap-grid">
      {providers.map((c) => (
        <div class="cap-card">
          <h3>{c.title}</h3>
          <p set:html={c.body}></p>
        </div>
      ))}
    </div>
    <p class="mt-8">
      Switch per run with <code>--provider</code> / <code>--model</code> /
      <code>--thinking</code>, mid-session with <code>/model</code>, or set defaults
      in <code>~/.config/glue/config.yaml</code>. And because <code>glue job teleport</code>
      writes a provider-neutral briefing, a job run on Gemini on AX continues
      seamlessly on Codex or DeepSeek locally.
    </p>
  </Section>

  <Section num="08" id="harness" tone="soft" eyebrow="Reliability" title="A harness that absorbs model sloppiness.">
    <p>
      Most wasted agent turns come from the harness, not the model: a
      failed edit match, a truncated log missing the error, an orphaned
      tool call that kills the next request. glue ports the consensus
      fixes from
      <a href="https://github.com/erain/glue/blob/main/docs/coding-harness-roadmap.md" rel="noopener">a source-level analysis</a>
      of pi, Cline, Codex CLI, and Gemini CLI — tuned for Gemini first
      and open-weight models second.
    </p>
    <div class="cap-grid mt-8">
      {harnessFeatures.map((c) => (
        <div class="cap-card">
          <h3>{c.title}</h3>
          <p set:html={c.body}></p>
        </div>
      ))}
    </div>
  </Section>

  <Section num="09" id="safety" eyebrow="Safety" title="Permission-gated locally, gVisor + Zero-Trust remotely.">
    <p>
      Locally, reads and navigation are free while <code>write_file</code>,
      <code>edit_file</code>, and <code>shell_exec</code> prompt inline with
      allow-once / allow-session / allow-file grades (<code>--yolo</code> and
      <code>--worktree</code> cover autonomous branches, and <code>@</code>-mentions
      blocklist <code>.env</code> and key files).
    </p>
    <p>
      Remotely, <code>glue --remote</code> isolates every job inside an AX gVisor
      sandbox with a default-deny TLS egress allowlist. Model and GitHub credentials
      are pushed in memory via <code>POST /v1/credentials</code> (never stored in
      <code>Task.spec.env</code> or exposed to agent shell commands), git pushes run
      through an out-of-band <code>GIT_ASKPASS</code> helper, and <code>ntfy</code>
      reply tokens are automatically redacted before events hit disk.
    </p>
  </Section>

  <Section num="0A" id="scriptable" tone="soft" eyebrow="Headless" title="Scriptable from day one.">
    <pre><code><span class="tok-d"># one-shot coding fix</span>
<span class="tok-g">$</span> glue code <span class="tok-a">--prompt</span> <span class="tok-c">"Run the tests and fix the first failure."</span>

<span class="tok-d"># pipe a diff in for review</span>
<span class="tok-g">$</span> git diff main | glue run <span class="tok-a">--prompt</span> <span class="tok-c">"Review this diff for race conditions."</span>

<span class="tok-d"># stable JSONL event stream for CI &amp; custom tooling</span>
<span class="tok-g">$</span> glue run <span class="tok-a">--coding --mode</span> json <span class="tok-a">--prompt</span> <span class="tok-c">"..."</span> | jq -r <span class="tok-c">'.type'</span></code></pre>
    <p>
      The same binary runs a local HTTP+SSE daemon
      (<code>glue serve --coding</code> / <code>glue connect</code>) that powers
      <code>glue job ui</code> and custom automation channels.
    </p>
  </Section>

  <Section num="0B" id="stack" eyebrow="Built on glue" title="One project, three faces.">
    <div class="cap-grid">
      <div class="cap-card">
        <h3>The framework</h3>
        <p>
          The composable Go SDK underneath: provider-agnostic loop, typed tools,
          SQLite FTS5 store, MCP client, compaction, and goal engine.
          <a href="https://glue-framework-site.vercel.app" rel="noopener">glue-framework-site.vercel.app</a>
        </p>
      </div>
      <div class="cap-card">
        <h3>glue-review</h3>
