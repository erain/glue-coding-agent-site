---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";

const title = "glue — a coding agent for your terminal, on any model";
const description =
  "glue is an open-source terminal coding agent in one static Go binary. Interactive TUI, permission-gated tools, autonomous goal loop, headless CI mode. Runs on Gemini, your ChatGPT subscription (Codex), or open-weight models via OpenRouter and NVIDIA.";

const providers = [
  {
    title: "Gemini (primary)",
    body: "Google's genai SDK with first-class Gemini 3.x support — thought-signature round-tripping, streamed reasoning, API-version pinning. <code>GEMINI_API_KEY</code> and go.",
  },
  {
    title: "Codex — your ChatGPT subscription",
    body: "No per-token bill. <code>codex login</code> once; glue reuses the auth. Intended for personal use.",
  },
  {
    title: "OpenRouter — open-weight models",
    body: "Kimi K2, Qwen, GLM, DeepSeek and friends by name — or <code>openrouter/free</code>, which auto-picks a currently-free model.",
  },
  {
    title: "NVIDIA build + failover",
    body: "OpenAI-compatible open-weight hosting via <code>NVIDIA_API_KEY</code>. <code>glue.WithFailover</code> skips providers whose keys aren't set.",
  },
];

const harnessFeatures = [
  {
    title: "Self-repairing edits",
    body: "Models misquote whitespace, indentation, and smart quotes constantly. <code>edit_file</code> repairs the drift with a deterministic match ladder, reports what it fixed, and echoes the updated lines back.",
  },
  {
    title: "Logs that keep the part that matters",
    body: "Long build output keeps the first error <em>and</em> the final status (head + tail), with the complete stream spooled to a named temp file the model can read back.",
  },
  {
    title: "Transcript repair",
    body: "Interrupted turns leave dangling tool calls that providers reject with opaque 400s. Every run repairs the history first — cancel, crash, resume, and model switches just work.",
  },
  {
    title: "Retries + overflow recovery",
    body: "Rate limits and dropped streams retry with backoff (honoring server hints); a blown context window triggers compact-once-and-retry instead of a dead session.",
  },
  {
    title: "Loop guardrails",
    body: "Repeating the same tool call, or burning turn after turn on failing calls, draws a corrective nudge first — and a clean typed stop if the model ignores it.",
  },
  {
    title: "Stall recovery",
    body: "Gemini's classic “I will now edit the file.”-then-silence gets a bounded “Please continue.” — the narration becomes the action.",
  },
];

const tuiFeatures = [
  {
    title: "Tool cards with inline permissions",
    body: "Every side-effecting tool call renders as a card with a spinner — and the [a]llow / [s]ession / [t]his-file / [n]o prompt right inside it. Reads never nag.",
  },
  {
    title: "edit_file diff preview",
    body: "See the exact surgical replacement before you approve it, not after.",
  },
  {
    title: "@-file and /-command pickers",
    body: "Type @ to fuzzy-pick a workspace file inline (secrets blocklisted); type / for filtering command autocomplete.",
  },
  {
    title: "Markdown transcript",
    body: "Streaming text re-renders as markdown after each turn settles. Mouse-wheel and PgUp/PgDn scroll; sticky-scroll keeps you pinned to the bottom only when you were there.",
  },
  {
    title: "Session tree",
    body: "/fork branches from any message, /clone duplicates, /tree visualizes the lineage and switches between branches.",
  },
  {
    title: "Context controls",
    body: "/compact summarizes older turns token-aware; /usage shows spend; /resume replays any stored session from a picker.",
  },
];
---

<Base title={title} description={description}>
  <section class="border-b border-line">
    <div class="max-w-3xl mx-auto px-6 pt-16 pb-16 sm:pt-20 sm:pb-20">
      <pre class="ascii-logo mb-8" aria-hidden="true">
       _
  __ _| |_   _  ___
 / _` | | | | |/ _ \
| (_| | | |_| |  __/
 \__, |_|\__,_|\___|
 |___/</pre>
      <div class="text-xs text-ink-muted tracking-wider mb-6">
        <span class="text-accent">[</span> open source <span class="text-accent">·</span> one static go binary <span class="text-accent">·</span> MIT <span class="text-accent">]</span>
      </div>
      <h1 class="text-3xl sm:text-[2.6rem] font-bold tracking-tight text-ink leading-[1.15] mb-6">
        A coding agent for your terminal.
        <br class="hidden sm:block" />
        <span class="glow">On any model.</span>
      </h1>
      <p class="text-base sm:text-lg text-ink-soft leading-relaxed max-w-2xl mb-10">
        <strong class="text-ink font-semibold">glue</strong> is an interactive
        coding agent — and a headless one for cron and CI. Gemini first-class,
        your ChatGPT subscription via Codex, or open-weight models through
        OpenRouter and NVIDIA. Permission-gated tools, an autonomous goal
        loop, and no runtime to install.
      </p>
      <div class="flex flex-wrap items-center gap-3 mb-10">
        <a href="https://github.com/erain/glue#the-glue-cli" class="btn btn-solid" rel="noopener">
          [ get started ]
        </a>
        <a href="https://github.com/erain/glue" class="btn btn-ghost" rel="noopener">
          [ view source ]
        </a>
      </div>
      <div class="term">
        <div class="term-bar">
          <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
          <span class="term-title">koheii@dev: ~/src/yourrepo</span>
        </div>
        <pre class="term-body"><code><span class="tok-g">$</span> go install github.com/erain/glue/cmd/glue@latest
<span class="tok-g">$</span> export GEMINI_API_KEY=<span class="tok-d">...</span>
<span class="tok-g">$</span> glue run <span class="tok-a">--coding</span> <span class="tok-a">--work</span> .

  <span class="tok-b">glue</span> <span class="tok-d">· no node, no python, no docker</span>
  <span class="tok-g">✓</span> provider  <span class="tok-c">gemini-3.x</span>     <span class="tok-d">(capability registry loaded)</span>
  <span class="tok-g">✓</span> tools     read_file edit_file grep shell_exec git_* …
  <span class="tok-g">✓</span> session   restored <span class="tok-d">·</span> history repaired <span class="tok-d">·</span> 0 orphaned calls

<span class="tok-a">›</span> what should we build?<span class="cursor" aria-hidden="true"></span></code></pre>
      </div>
      <div class="text-xs text-ink-muted tracking-wide mt-6">
        gemini <span class="text-accent">·</span> chatgpt subscription (codex) <span class="text-accent">·</span> openrouter open-weights <span class="text-accent">·</span> nvidia build <span class="text-accent">·</span> goal loop <span class="text-accent">·</span> tui + headless
      </div>
    </div>
  </section>

  <Section num="01" id="what" eyebrow="What it is" title="The coding agent that doesn't pick your model.">
    <p>
      Most coding agents are a front-end for one vendor. glue is the
      harness: an interactive TUI, a permission-gated local tool set
      (<code>read_file</code>, <code>edit_file</code>, <code>grep</code>,
      <code>shell_exec</code>, git helpers, …), and an agent loop that runs
      the same way on every provider it ships —
      <strong>Gemini</strong> as the primary target, <strong>Codex</strong>
      against your existing ChatGPT subscription, and
      <strong>open-weight models</strong> (Kimi K2, Qwen, GLM, DeepSeek)
      through OpenRouter or NVIDIA build.
    </p>
    <p>
      It installs as one static Go binary. No Node, no Python, no Docker —
      <code>go install</code> and you're coding.
    </p>
    <p>
      Under the hood it's the reference consumer of the
      <a href="https://glue-framework-site.vercel.app" rel="noopener">glue agent framework</a>:
      the coding tool bundle, the loop, sessions, and permissions are all
      library API you can reuse in your own agents
      (<a href="https://github.com/erain/glue/blob/main/docs/adr/0012-sdk-coding-agent-peggy-boundary.md" rel="noopener">ADR-0012</a>).
    </p>
  </Section>

  <Section num="02" id="tui" tone="soft" eyebrow="Interactive" title="A TUI that stays out of the way.">
    <div class="term">
      <div class="term-bar">
        <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
        <span class="term-title">glue · session 4f2a · gemini-3.x</span>
      </div>
      <pre class="term-body"><code><span class="tok-g">▶</span> <span class="tok-b">edit_file</span>  internal/server/router.go
    <span class="tok-r">- mux.Handle("/healthz", health)</span>
    <span class="tok-g">+ mux.Handle("/healthz", logged(health))</span>
    <span class="tok-a">[a]llow once   [s]ession   [t]his file   [n]o</span>

<span class="tok-c">⠸</span> <span class="tok-b">shell_exec</span>  go test ./internal/server/

  All 14 tests pass. The health endpoint now logs
  requests like every other route.

<span class="tok-a">›</span> fix the flaky TestRetryBackoff next<span class="cursor" aria-hidden="true"></span></code></pre>
    </div>
    <div class="cap-grid mt-8">
      {tuiFeatures.map((c) => (
        <div class="cap-card">
          <h3>{c.title}</h3>
          <p set:html={c.body}></p>
        </div>
      ))}
    </div>
    <p class="mt-8">
      Run <code>glue run --coding --work .</code> in a terminal and the TUI
      opens by default. Designed in
      <a href="https://github.com/erain/glue/blob/main/docs/adr/0014-coding-agent-tui.md" rel="noopener">ADR-0014</a>
      and <a href="https://github.com/erain/glue/blob/main/docs/adr/0015-session-tree.md" rel="noopener">ADR-0015</a>.
    </p>
  </Section>

  <Section num="03" id="goal" eyebrow="Autonomous" title="The goal loop: plan, make, verify — repeat.">
    <p>
      <code>/goal</code> in the TUI (or <code>glue goal</code> headless)
      turns one objective into an autonomous loop: a planner decomposes it
      into a verifiable checklist, a fresh <strong>maker</strong> session
      works each iteration, and a separate <strong>checker</strong> session
      audits the evidence — the writer never grades its own homework.
      Guardrails bound it: max iterations, no-progress detection, token
      budget.
    </p>
    <pre><code><span class="tok-d"># pursue a goal autonomously: plan → make → verify, per iteration</span>
<span class="tok-g">$</span> glue goal <span class="tok-a">--coding --yolo --worktree</span> \
    <span class="tok-c">"Make golangci-lint pass on ./... without disabling checks"</span>

<span class="tok-d"># exit code reflects the outcome:</span>
<span class="tok-d">#</span> <span class="tok-g">0</span> achieved <span class="tok-d">·</span> <span class="tok-a">2</span> blocked <span class="tok-d">·</span> <span class="tok-a">3</span> max-iterations <span class="tok-d">·</span> <span class="tok-a">4</span> budget <span class="tok-d">·</span> <span class="tok-r">1</span> error

<span class="tok-g">$</span> glue goal <span class="tok-a">--list</span>      <span class="tok-d"># stored goals with status and age</span>
<span class="tok-g">$</span> glue goal <span class="tok-a">--resume</span>    <span class="tok-d"># continue from the verified checklist</span></code></pre>
    <p>
      Goals checkpoint to the session store, so they survive restarts and
      resume from the last verified checklist. <code>--worktree</code> runs
      the whole loop in an isolated git worktree on branch
      <code>goal/&lt;id&gt;</code> — your checkout stays untouched and the
      result is a reviewable branch, never an auto-merge. Status-mapped
      exit codes make it schedulable from cron, CI, or another agent.
      Designed in
      <a href="https://github.com/erain/glue/blob/main/docs/adr/0016-goal-loop.md" rel="noopener">ADR-0016</a>.
    </p>
  </Section>

  <Section num="04" id="providers" tone="soft" eyebrow="Models" title="Bring a key, a subscription, or neither.">
    <div class="cap-grid">
      {providers.map((c) => (
        <div class="cap-card">
          <h3>{c.title}</h3>
          <p set:html={c.body}></p>
        </div>
      ))}
    </div>
    <p class="mt-8">
      Switch with <code>--provider</code> / <code>--model</code>, or
      mid-session with <code>/model</code>. A per-provider capability
      registry — context window, parallel-tool safety, prompt variant,
      stall-proneness — tunes the harness automatically, so the agent
      behaves the same everywhere without if-this-model-then hacks.
    </p>
  </Section>

  <Section num="05" id="harness" eyebrow="Reliability" title="A harness that absorbs model sloppiness.">
    <p>
      Most wasted agent turns come from the harness, not the model: a
      failed edit match, a truncated log missing the error, an orphaned
      tool call that kills the next request. glue ports the consensus
      fixes from
      <a href="https://github.com/erain/glue/blob/main/docs/coding-harness-roadmap.md" rel="noopener">a source-level analysis</a>
      of pi, Cline, Codex CLI, and Gemini CLI — tuned for Gemini first
      and open-weight models second.
    </p>
    <div class="cap-grid mt-8">
      {harnessFeatures.map((c) => (
        <div class="cap-card">
          <h3>{c.title}</h3>
          <p set:html={c.body}></p>
        </div>
      ))}
    </div>
  </Section>

  <Section num="06" id="safety" tone="soft" eyebrow="Safety" title="Permission-gated, honestly scoped.">
    <p>
      Reads and navigation are free; <code>write_file</code>,
      <code>edit_file</code>, and <code>shell_exec</code> ask first —
      inline, in the tool card, with allow-once / allow-for-session /
      allow-for-file grades. <code>--yolo</code> auto-approves everything
      for trusted feature branches, and goal runs prefer
      <code>--worktree</code> isolation so even full autonomy can't touch
      your checkout.
    </p>
    <p>
      What glue does <em>not</em> claim: a sandbox. Execution is local by
      design, and the <code>Executor</code> seam is where a
      container/VM backend plugs in — it's on the
      <a href="https://github.com/erain/glue/issues/110" rel="noopener">roadmap</a>.
      The <code>@</code>-mention picker and <code>grep</code> refuse
      secret-shaped files (<code>.env</code>, keys) on their own.
    </p>
  </Section>

  <Section num="07" id="scriptable" eyebrow="Headless" title="Scriptable from day one.">
    <pre><code><span class="tok-d"># one-shot</span>
<span class="tok-g">$</span> glue run <span class="tok-a">--coding --prompt</span> <span class="tok-c">"Run the tests, fix the first failure."</span>

<span class="tok-d"># pipe a prompt in</span>
<span class="tok-g">$</span> git diff main | glue run <span class="tok-a">--prompt</span> <span class="tok-c">"Review this diff for bugs."</span>

<span class="tok-d"># stable JSONL events for scripting</span>
<span class="tok-g">$</span> glue run <span class="tok-a">--coding --mode</span> json <span class="tok-a">--prompt</span> <span class="tok-c">"..."</span> | jq -r <span class="tok-c">'.type'</span></code></pre>
    <p>
      The same binary serves a local HTTP+SSE daemon
      (<code>glue serve</code> / <code>glue connect</code>) that streams
      runs and brokers permission prompts to the connected client — the
      protocol other channels (Telegram, dashboards) build on.
    </p>
  </Section>

  <Section num="08" id="stack" tone="soft" eyebrow="Built on glue" title="One project, three faces.">
    <div class="cap-grid">
      <div class="cap-card">
        <h3>The framework</h3>
        <p>
          The Go library underneath: provider-agnostic loop, typed tools,
          stores, MCP, daemon.
          <a href="https://glue-framework-site.vercel.app" rel="noopener">glue-framework-site.vercel.app</a>
        </p>
      </div>
      <div class="cap-card">
        <h3>glue-review</h3>
        <p>
          A free pre-push branch reviewer that posts one sticky PR comment.
          <a href="https://glue-review.vercel.app" rel="noopener">glue-review.vercel.app</a>
        </p>
      </div>
      <div class="cap-card">
        <h3>peggy</h3>
        <p>
          A long-running personal assistant: Telegram, durable memory,
          schedules.
          <a href="https://github.com/erain/glue/tree/main/agents/peggy" rel="noopener">GitHub</a>
        </p>
      </div>
      <div class="cap-card">
        <h3>This coding agent</h3>
        <p>
          <code>cmd/glue</code> in the same repo — the framework's own
          daily driver and dogfood.
          <a href="https://github.com/erain/glue/tree/main/cmd/glue" rel="noopener">Source</a>
        </p>
      </div>
    </div>
  </Section>

  <section id="faq" class="border-b border-line bg-paper">
    <div class="max-w-3xl mx-auto px-6 py-16 sm:py-20">
      <div class="flex items-baseline gap-3 mb-3">
        <span class="section-num">[0x09]</span>
        <span class="text-xs tracking-wider text-ink-muted">// faq</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-ink mb-8 leading-snug">
        <span class="text-accent" aria-hidden="true">#</span> Anticipated questions.
      </h2>
      <div class="space-y-7 prose-body text-[15px] sm:text-base">
        <div>
          <h3 class="text-ink font-semibold mb-2"><span class="text-accent">?</span> How is this different from Claude Code, Codex CLI, or Gemini CLI?</h3>
          <p>
            Those are excellent harnesses for one vendor's models. glue is
            model-agnostic by construction: the same TUI, tools, permission
            model, and goal loop on Gemini, a ChatGPT subscription, or
            open-weight models — switchable per session. And the whole
            agent is library API underneath, so what the binary does, your
            own Go agent can do too.
          </p>
        </div>
        <div>
          <h3 class="text-ink font-semibold mb-2"><span class="text-accent">?</span> Can I run it for free?</h3>
          <p>
            Two honest paths: the Codex provider rides your existing
            ChatGPT subscription (no per-token bill), and
            <code>--provider openrouter --model openrouter/free</code>
            auto-picks a currently-free open-weight model. Expect free
            models to be slower and less reliable than Gemini.
          </p>
        </div>
        <div>
          <h3 class="text-ink font-semibold mb-2"><span class="text-accent">?</span> Is it sandboxed?</h3>
          <p>
            No — and it says so instead of pretending. Side effects are
            permission-gated, goal runs can be isolated in a git worktree,
            and the <code>Executor</code> interface is the seam where a
            container/VM backend will plug in. Until then, treat
            <code>--yolo</code> like you'd treat any tool with shell access.
          </p>
        </div>
        <div>
          <h3 class="text-ink font-semibold mb-2"><span class="text-accent">?</span> Which model should I use?</h3>
          <p>
            Gemini 3.x is the primary target and gets the most harness
            attention (thought-signature replay, streamed reasoning,
            stall recovery). Codex is the zero-marginal-cost daily
            driver if you already pay for ChatGPT. Open-weight models
            via OpenRouter/NVIDIA are the explicit second target: the
            v1.13.0 reliability work (self-repairing edits, guardrails,
            retries) is tuned for exactly their failure modes.
          </p>
        </div>
        <div>
          <h3 class="text-ink font-semibold mb-2"><span class="text-accent">?</span> Where does it run?</h3>
          <p>
            Anywhere a Go binary runs — Linux and macOS terminals today.
            The TUI needs a real terminal; everything else
            (<code>--prompt</code>, pipes, <code>--mode json</code>,
            <code>glue goal</code>, <code>glue serve</code>) is headless.
          </p>
        </div>
        <div>
          <h3 class="text-ink font-semibold mb-2"><span class="text-accent">?</span> API stability?</h3>
          <p>
            The CLI surface is stable in practice; the library underneath
            reserves the right to break API on minor bumps until a
            deliberate lock — see the
            <a href="https://github.com/erain/glue/blob/main/docs/adr/0013-pre-1-0-stability-stance.md" rel="noopener">stability stance</a>
            and <a href="https://github.com/erain/glue/blob/main/CHANGELOG.md" rel="noopener">CHANGELOG</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
